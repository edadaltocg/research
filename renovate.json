{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "prConcurrentLimit": 5,
  "rangeStrategy": "widen",
  "semanticCommits": "enabled",
  "commitMessagePrefix": null,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["every weekend"]
  },
  "labels": ["renovate"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "matchPackageNames": [
        "python"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": ["torch", "torchvision", "torchaudio"],
      "groupName": "pytorch"
    }
  ]
}
