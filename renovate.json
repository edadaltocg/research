{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "semanticCommits": "enabled",
  "dependencyDashboard": true,
  "timezone": "UTC",
  "packageRules": [
    {
      "matchPackageNames": ["torch", "torchvision", "torchaudio"],
      "groupName": "pytorch"
    }
  ]
}
